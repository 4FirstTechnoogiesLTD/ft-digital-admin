# ─────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
# Server-only. Never expose to the browser. Used by the inbound webhook and admin/invite flows.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Vite exposes VITE_* to the browser bundle. The browser Supabase client uses these.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ─────────────────────────────────────────────────────────────
# Resend
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Signing secret for the Resend "email.received" webhook (Svix). Dashboard → Webhooks.
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# Subdomain verified in Resend for receiving + sending team mail.
MAIL_DOMAIN=mail.4firsttech.com
# Inbound mail sent to an address with no matching mailbox is routed here.
SHARED_MAILBOX_OWNER=hello@mail.4firsttech.com

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
